# ===== Raw data =====
# Everything raw is excluded by default; curated, small, reproducibility-
# critical datasets are un-ignored explicitly below.
data/raw/*
!data/raw/wris/
!data/raw/wris_v2/
!data/raw/enso/
!data/raw/climate_indices/
!data/raw/era5/
data/raw/era5/*
!data/raw/era5/reservoir_era5_daily.csv
# wris: keep canonical CSVs + manifests, drop local backups
data/raw/wris/backup_pre_ka_patch/
# enso: drop local backup of the pre-IOD climate file
data/raw/enso/*.backup*

# ===== Karnataka WRD source (needed to reproduce patch_ka_inflow.py) =====
.cluster/inflow-data/*
!.cluster/inflow-data/karnataka_man_reservoir_data.csv

